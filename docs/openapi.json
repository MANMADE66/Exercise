{
  "components": {
    "schemas": {
      "ActualItemOut": {
        "description": "实际条目；`planned_item_id` 为 null 表示计划外新增（FR-7.3）。",
        "properties": {
          "exercise": {
            "description": "动作名",
            "title": "Exercise",
            "type": "string"
          },
          "id": {
            "description": "实际条目 id（行内更新、删除用）",
            "title": "Id",
            "type": "integer"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "该行备注",
            "title": "Note"
          },
          "planned_item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "对应的计划条目 id；计划外条目为 null",
            "title": "Planned Item Id"
          },
          "position": {
            "description": "当天顺序，从 0 起连续",
            "title": "Position",
            "type": "integer"
          },
          "reps": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "实际次数，自由文本",
            "title": "Reps"
          },
          "sets": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "实际组数",
            "title": "Sets"
          },
          "weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "实际重量（kg）",
            "title": "Weight Kg"
          }
        },
        "required": [
          "id",
          "exercise",
          "position"
        ],
        "title": "ActualItemOut",
        "type": "object"
      },
      "BodyMetricOut": {
        "description": "周体重（SRS FR-10）：月历周行的只读展示；票 15 的写入端点复用同一形状。",
        "properties": {
          "body_fat_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "体脂率（百分比）",
            "title": "Body Fat Pct"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "备注",
            "title": "Note"
          },
          "week_start": {
            "description": "周起点，恒为周一",
            "format": "date",
            "title": "Week Start",
            "type": "string"
          },
          "weight_kg": {
            "description": "体重（公斤）",
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "week_start",
          "weight_kg"
        ],
        "title": "BodyMetricOut",
        "type": "object"
      },
      "CalendarAggregate": {
        "description": "月历聚合（SRS FR-4）：整周网格 + 概要 + 已记录日期 + 周体重。",
        "properties": {
          "logged_dates": {
            "description": "存在实际条目的日期集合（升序；不是「存在计划日」的日期）",
            "items": {
              "format": "date",
              "type": "string"
            },
            "title": "Logged Dates",
            "type": "array"
          },
          "month": {
            "description": "生效月份 1–12",
            "title": "Month",
            "type": "integer"
          },
          "weeks": {
            "description": "按周排列的网格，首行不一定是当月 1 日",
            "items": {
              "$ref": "#/components/schemas/CalendarWeek"
            },
            "title": "Weeks",
            "type": "array"
          },
          "year": {
            "description": "生效年份（?month 非法或缺失时已回退为当月）",
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year",
          "month",
          "weeks",
          "logged_dates"
        ],
        "title": "CalendarAggregate",
        "type": "object"
      },
      "CalendarCell": {
        "description": "月历网格的一格。\n\n`kind` / `title` 为 `null` 表示该日没有 PlanDay（还没排计划），这与补齐位是两回事：\n补齐位（月初日前 / 月末日后）在 `CalendarWeek.cells` 里直接是 `null`，不是空格子。",
        "properties": {
          "date": {
            "description": "日期",
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "train",
                  "rest"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "计划日类型",
            "title": "Kind"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "计划日标题；无标题训练日不显示标签",
            "title": "Title"
          }
        },
        "required": [
          "date"
        ],
        "title": "CalendarCell",
        "type": "object"
      },
      "CalendarWeek": {
        "description": "月历的一行（一个自然周）：7 格 + 该周体重。",
        "properties": {
          "cells": {
            "description": "7 格，周一为第一列；补齐位为 null",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/CalendarCell"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Cells",
            "type": "array"
          },
          "metric": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BodyMetricOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "该周的体重记录，没填就是 null"
          },
          "week_start": {
            "description": "周起点，该周第一个日期的周一（可能落在上一个月）",
            "format": "date",
            "title": "Week Start",
            "type": "string"
          }
        },
        "required": [
          "week_start",
          "cells"
        ],
        "title": "CalendarWeek",
        "type": "object"
      },
      "Credentials": {
        "description": "注册与登录共用（两端字段与校验完全一致，前端也只消费这一种形状）。",
        "properties": {
          "password": {
            "description": "密码，至少 6 个字符",
            "title": "Password",
            "type": "string"
          },
          "username": {
            "description": "用户名，去首尾空白后 3–20 个字符",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "DayAggregate": {
        "description": "一天的全部数据（FR-5.1）。\n\n无记录的日期：`kind` / `title` 为 null、两个集合为空、`note` 为空串 —— 前端不需要区分\n「没排计划」与「空字段」，也绝不因为读一次就凭空多出一个 PlanDay（FR-5.2）。",
        "properties": {
          "actual_items": {
            "description": "全部实际条目，按 position 升序",
            "items": {
              "$ref": "#/components/schemas/ActualItemOut"
            },
            "title": "Actual Items",
            "type": "array"
          },
          "date": {
            "description": "请求的日期（YYYY-MM-DD）",
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "train",
                  "rest"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "训练日 / 休息日；当天没有 PlanDay 时为 null",
            "title": "Kind"
          },
          "note": {
            "default": "",
            "description": "感受笔记；没有记录时为空串",
            "title": "Note",
            "type": "string"
          },
          "planned_items": {
            "description": "全部计划条目，按 position 升序",
            "items": {
              "$ref": "#/components/schemas/PlannedItemOut"
            },
            "title": "Planned Items",
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "当天标题；当天没有 PlanDay 时为 null",
            "title": "Title"
          }
        },
        "required": [
          "date"
        ],
        "title": "DayAggregate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "description": "服务状态",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "API 版本号",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PlanItemCreate": {
        "description": "添加计划条目（FR-6.1）：动作名自动建入本人动作库，新条目置于当天末位。",
        "properties": {
          "exercise": {
            "description": "动作名，去首尾空白后不能为空",
            "title": "Exercise",
            "type": "string"
          },
          "reps": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "次数原文本，自由文本如 8-12",
            "title": "Reps"
          },
          "sets": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "组数原文本，如 4",
            "title": "Sets"
          },
          "weight": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "重量原文本，如 60 / 60kg / 62,5",
            "title": "Weight"
          }
        },
        "required": [
          "exercise"
        ],
        "title": "PlanItemCreate",
        "type": "object"
      },
      "PlanItemMove": {
        "description": "上下移动（FR-6.3）：已在边界（首个上移 / 末个下移）时静默成功。",
        "properties": {
          "direction": {
            "description": "up 上移 / down 下移",
            "enum": [
              "up",
              "down"
            ],
            "title": "Direction",
            "type": "string"
          }
        },
        "required": [
          "direction"
        ],
        "title": "PlanItemMove",
        "type": "object"
      },
      "PlannedItemOut": {
        "description": "计划条目：动作只出名字（动作库按用户隔离且 (user_id, name) 唯一，名字即身份）。",
        "properties": {
          "exercise": {
            "description": "动作名（已建入本人动作库）",
            "title": "Exercise",
            "type": "string"
          },
          "id": {
            "description": "计划条目 id（删除、上下移用）",
            "title": "Id",
            "type": "integer"
          },
          "position": {
            "description": "当天顺序，从 0 起连续",
            "title": "Position",
            "type": "integer"
          },
          "reps": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "次数，自由文本（如 8-12）",
            "title": "Reps"
          },
          "sets": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "组数，解析失败为 null",
            "title": "Sets"
          },
          "weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "计划重量（kg），解析失败为 null",
            "title": "Weight Kg"
          }
        },
        "required": [
          "id",
          "exercise",
          "position"
        ],
        "title": "PlannedItemOut",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "token": {
            "description": "JWT，前端存 localStorage 并在后续请求带 Bearer",
            "title": "Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic",
            "description": "当前用户"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserPublic": {
        "description": "对外可见的用户身份（用户名即身份，SRS §2.2；永不返回密码字段）。",
        "properties": {
          "username": {
            "description": "用户名",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "UserPublic",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "登录后拿到的 JWT（Bearer）",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "训练记录 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "用户名或密码不对"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "用户名已被占用"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "注册并登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/calendar": {
      "get": {
        "operationId": "get_calendar_calendar_get",
        "parameters": [
          {
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarAggregate"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "月历聚合",
        "tags": [
          "calendar"
        ]
      }
    },
    "/days/{iso_date}": {
      "get": {
        "description": "读取整天聚合；当天没有任何记录时返回空结构，**不落库**（FR-5.2）。",
        "operationId": "read_day_days__iso_date__get",
        "parameters": [
          {
            "in": "path",
            "name": "iso_date",
            "required": true,
            "schema": {
              "title": "Iso Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayAggregate"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "日期格式非法，需 YYYY-MM-DD"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "日聚合",
        "tags": [
          "days"
        ]
      }
    },
    "/days/{iso_date}/plan-items": {
      "post": {
        "description": "添加计划条目（FR-6.1）；动作名自动建入本人动作库，空动作名在契约层就已 422。",
        "operationId": "create_plan_item_days__iso_date__plan_items_post",
        "parameters": [
          {
            "in": "path",
            "name": "iso_date",
            "required": true,
            "schema": {
              "title": "Iso Date",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanItemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayAggregate"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "日期格式非法，需 YYYY-MM-DD"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "添加计划条目",
        "tags": [
          "days"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "存活探针",
        "tags": [
          "system"
        ]
      }
    },
    "/plan-items/{plan_item_id}": {
      "delete": {
        "description": "删除计划条目（FR-6.2）：关联的实际条目保留，其 `planned_item_id` 置空。",
        "operationId": "delete_plan_item_plan_items__plan_item_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "plan_item_id",
            "required": true,
            "schema": {
              "title": "Plan Item Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayAggregate"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "删除计划条目",
        "tags": [
          "days"
        ]
      }
    },
    "/plan-items/{plan_item_id}/move": {
      "post": {
        "description": "上下移动（FR-6.3）：边界（首个上移 / 末个下移）静默成功。",
        "operationId": "move_plan_item_plan_items__plan_item_id__move_post",
        "parameters": [
          {
            "in": "path",
            "name": "plan_item_id",
            "required": true,
            "schema": {
              "title": "Plan Item Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
